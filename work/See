def doc_keys(num, context):
    def make_key(key_name, list_name, points):
        if item[key_name]>0:
            for task in item[list_name]:
                # определям броя отговори и броя верни отговори
                numOkBase = 0   # брой верни отговори по ключ
                numOptions = len(task['options'])  #  брой отговори към въпроса
                task['points'] = points
                if task['type'] < 3: #  затворен отговор
                    for option in task['options']:
                        if option['checked']:
                            numOkBase += 1
                    if numOkBase == 1:
                        key_list = [f'при посочен верен отговор - {points} точки;',
                                        'във всички останали случаи - 0 точки',
                                        ]
                    else:
                        key_list = [f'при посочен 1 верен отговор - {round(points*(1/numOkBase), 2)} точки;',]
                        for i in range(2,numOkBase):
                            key_list.append(f'при посочен {i} верни отговора - {round(points*(i/numOkBase), 2)} точки;')
                        key_list.append(f'при посочени {numOkBase} верни отговора - {points} точки')
                        key_list.append(f'при посочени повече от {numOkBase} отговора - 0 точки')
                        key_list.append('във всички останали случаи  - 0 точки')
                    task['key_list'] = key_list
                elif task['type']<5:
                    s = round(points*(1/numOptions), 2)
                    p = ' точки'
                    if s == 1.00:
                        p = ' точка'
                    task['ok'] = str(s)+p

    doc = DocxTemplate("C:/DZI_2024/DIKI_Print/TestMaker/main/docs/keys_template.docx")

    for item in context['test']:
        make_key('knowledge','tasks_knowledge', 2)
        make_key('analysis','tasks_analysis', 8)
        make_key('application','tasks_application', 6)
        make_key('comprehension','tasks_comprehension', 4)

    doc.render(context)
    doc.save("C:/DZI_2024/DIKI_Print/TestMaker/main/themes/THEME_"+num+"_KEYS.docx")
